<Window x:Class="Revit.Addin._2027.DatabaseLink.LinkProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link project"
        Width="600" Height="660" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF" Foreground="#2A3447" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <!-- The look follows the mockup (claude.ai/artifact/TVSdpLgGotaWpp4PNro3Ed, "Which project is this model?"). -->
    <Window.Resources>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A5FCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#5B6578"/>
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="BorderBrush" Value="#C9CFD8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#1F6FEB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="#FFFFFF" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F7F9FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F5F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProjectRowTemplate">
            <DockPanel>
                <RadioButton DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                             Focusable="False" IsHitTestVisible="False"
                             IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <Border DockPanel.Dock="Left" MinWidth="64" Padding="6,1" Margin="0,0,10,0" CornerRadius="4"
                        Background="#ECEEF2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Code}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                               Foreground="#2A3447" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="12" Foreground="#5B6578"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock x:Name="ProjectName" Text="{Binding Name}" Foreground="#0F1B2D"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="ProjectName" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, and what the model is linked to -->
        <DockPanel Grid.Row="0" Margin="24,20,24,14">
            <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" CornerRadius="8"
                    Background="#E8F0FE" VerticalAlignment="Top">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M10,14 A4,4 0 0 0 15.66,14 L18.66,11 A4,4 0 0 0 13,5.34 L12,6.34"
                              Stroke="#1F6FEB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                        <Path Data="M14,10 A4,4 0 0 0 8.34,10 L5.34,13 A4,4 0 0 0 11,18.66 L12,17.66"
                              Stroke="#1F6FEB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel>
                <TextBlock Text="Which project is this model?" FontSize="18" FontWeight="SemiBold" Foreground="#0F1B2D"/>
                <TextBlock x:Name="Subtitle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5B6578"/>
            </StackPanel>
        </DockPanel>

        <!-- What the Project Number suggests, or what went wrong -->
        <Border x:Name="Banner" Grid.Row="1" Margin="24,0,24,12" Padding="12,10" CornerRadius="8" BorderThickness="1">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="BannerIcon" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M5.6,18.4 L7.7,16.3 M16.3,7.7 L18.4,5.6"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="12.5" Foreground="#1F2630"/>
            </DockPanel>
        </Border>

        <!-- Search -->
        <Border Grid.Row="2" Margin="24,0,24,10" Height="34" CornerRadius="6" BorderThickness="1"
                Background="#FFFFFF" Style="{StaticResource SearchBox}">
            <Grid>
                <Viewbox Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left">
                    <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="14" Height="14" Stroke="#5B6578" StrokeThickness="2"/>
                        <Path Data="M20,20 L16.5,16.5" Stroke="#5B6578" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="SearchHint" Text="Search by number or name" Foreground="#8A93A3"
                           Margin="35,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="Search" Margin="31,0,8,0" VerticalAlignment="Center" BorderThickness="0"
                         Background="Transparent" Foreground="#0F1B2D" AutomationProperties.Name="Search projects"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>
            </Grid>
        </Border>

        <!-- The projects -->
        <Border Grid.Row="3" Margin="24,0" CornerRadius="8" BorderThickness="1" BorderBrush="#E4E7EC">
            <Grid>
                <ListBox x:Name="Projects" Margin="1" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Projects in the MH database"
                         ItemContainerStyle="{StaticResource ProjectRowItem}"
                         ItemTemplate="{StaticResource ProjectRowTemplate}"
                         SelectionChanged="OnProjectSelected" MouseDoubleClick="OnProjectDoubleClick"/>
                <TextBlock x:Name="ListMessage" Margin="12,16" Foreground="#5B6578" TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="4" Margin="0,16,0,0" Padding="24,14" Background="#F7F8FA" BorderBrush="#E4E7EC"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="LinkButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" Content="Pick a project" Click="OnLink"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" IsCancel="True" Content="Cancel"/>
                <TextBlock Text="Saved in the model, so everyone who opens it works with the same project."
                           FontSize="12" Foreground="#5B6578" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
