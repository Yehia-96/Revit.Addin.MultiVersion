<UserControl x:Class="Revit.Addin._2027.DatabaseLink.Pane.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF" Foreground="#2A3447" FontFamily="Segoe UI" FontSize="13"
             UseLayoutRounding="True" MinWidth="240">

    <!-- The MH Database pane, laid out like the mockup's: the state on top, the model and the database's
         changes in the middle, how often to look at the bottom. Its words come from PaneTexts. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>
        <SolidColorBrush x:Key="Strong" Color="#0F1B2D"/>
        <SolidColorBrush x:Key="Muted" Color="#5B6578"/>
        <SolidColorBrush x:Key="Line" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="Soft" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="ChipBack" Color="#ECEEF2"/>
        <SolidColorBrush x:Key="LinkBlue" Color="#1A5FCC"/>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Strong}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ChipBack}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1F6FEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A5FCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Foreground" Value="{StaticResource LinkBlue}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A281C"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5A79F"/>
        </Style>

        <Style x:Key="CountButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ToolTip" Value="Select them in the model"/>
        </Style>

        <!-- One object's or material's changes: its ID and name, then each value as model → database. -->
        <DataTemplate x:Key="ChangeRowTemplate">
            <StackPanel Margin="0,7">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Who}" FontSize="11.5" Foreground="{StaticResource Muted}"
                               Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding Parameter}" FontWeight="SemiBold" Foreground="{StaticResource Strong}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <WrapPanel Margin="0,3,0,0">
                    <TextBlock Text="{Binding From}" FontFamily="{StaticResource CodeFont}" FontSize="11.5"
                               Foreground="{StaticResource Muted}" TextDecorations="Strikethrough" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Viewbox Width="14" Height="14" Margin="6,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5,12 H19 M13,6 L19,12 L13,18" Stroke="{StaticResource Muted}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <Border Background="#E8F0FE" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding To}" FontFamily="{StaticResource CodeFont}" FontSize="11.5"
                                   Foreground="{StaticResource Strong}" TextWrapping="Wrap"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChangeGroupTemplate">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                <StackPanel>
                    <Border Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding Key}" FontFamily="{StaticResource CodeFont}" FontSize="11.5"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Strong}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ChangeRowTemplate}" Margin="12,4,12,4"
                                  Focusable="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,10">
                        <Button Style="{StaticResource LinkButton}" Height="28"
                                Command="{Binding ShowCommand}" Visibility="{Binding CanShow, Converter={StaticResource Visible}}"
                                ToolTip="Selects the object's elements and zooms to them">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M19,12 A7,7 0 1 1 5,12 A7,7 0 1 1 19,12 Z M12,2 V6 M12,18 V22 M2,12 H6 M18,12 H22"
                                              Stroke="{StaticResource LinkBlue}" StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Show in model"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Content="{Binding ApplyLabel}"
                                Command="{Binding ApplyCommand}" Visibility="{Binding CanApply, Converter={StaticResource Visible}}"
                                ToolTip="Writes this card's values into the model, in one undo step"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The state: dot, title, the database, and when it last answered -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10,8,10">
            <StackPanel>
                <DockPanel MinHeight="28" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Width="28" Height="28" Padding="0"
                            Command="{Binding CheckNowCommand}" ToolTip="Check now"
                            AutomationProperties.Name="Check for changes now"
                            Visibility="{Binding CanCheckNow, Converter={StaticResource Visible}}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M20,11 A8,8 0 1 0 17.66,16.66 M20,4 V11 H13" Stroke="#3F4855" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Strong}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Where}" FontSize="12" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding When}" Margin="16,0,0,0" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>

                <!-- No project model -->
                <StackPanel Margin="14,18" Visibility="{Binding ShowNoModel, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource CardTitle}" Text="No project model is active"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="13"
                               Text="Open a project model, or switch to one of its views: the pane then shows its link to the MH database and the database's changes."/>
                </StackPanel>

                <!-- No connection file -->
                <StackPanel Margin="14,18" Visibility="{Binding ShowNoFile, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource CardTitle}" Text="This computer has no connection file"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="13"
                               Text="The link needs the file the MH.RevitTools installer puts on each computer. Revit itself keeps working as usual."/>
                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource Line}" Background="{StaticResource Soft}">
                        <StackPanel>
                            <TextBlock Text="Expected here" FontSize="12" FontWeight="SemiBold" Foreground="#3F4855"/>
                            <TextBlock Text="{Binding NoFilePath}" Margin="0,6,0,0" FontFamily="{StaticResource CodeFont}" FontSize="12"
                                       Foreground="{StaticResource Strong}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="{Binding NoFileProblem}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="Ask whoever installs the add-in on this computer to run the installer again. The pane finds the file at its next check."/>
                </StackPanel>

                <!-- Not linked: two steps -->
                <StackPanel Margin="14,18" Visibility="{Binding ShowSetup, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Link this model to the MH database"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="13"
                               Text="The pane then shows where the model differs from the database: what changed in Studio, who changed it and when. Two steps, once per model."/>
                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#A9C5F7" Background="#F5F9FF">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="#1F6FEB"
                                    VerticalAlignment="Top" Margin="0,0,12,0">
                                <TextBlock Text="1" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Link the model to its project" FontWeight="SemiBold" Foreground="{StaticResource Strong}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="The dialog suggests a project from the model's Project Number."/>
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Content="Link the model…"
                                        Command="{Binding LinkCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="#ECEEF2"
                                    VerticalAlignment="Top" Margin="0,0,12,0">
                                <TextBlock Text="2" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Check the parameters" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="The link fills the shared parameters of Studio's master file. It never adds parameters by itself."/>
                                <Button Style="{StaticResource LinkButton}" Margin="-6,6,0,0" Content="Check parameters…"
                                        Command="{Binding CheckParametersCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- This model -->
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,12"
                        Visibility="{Binding ShowModel, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="12" Margin="0,-3,-6,0"
                                    Content="Change project…" Command="{Binding LinkCommand}"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="THIS MODEL" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding ProjectCode}" FontFamily="{StaticResource CodeFont}" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding ProjectName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Strong}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{Binding LinkedLine}"/>
                        <UniformGrid Columns="3" Margin="0,10,0,0" Visibility="{Binding ShowCounts, Converter={StaticResource Visible}}">
                            <Button Style="{StaticResource CountButton}" Margin="0,0,6,0" Command="{Binding SelectLinkedCommand}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LinkedCount}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Strong}"/>
                                    <TextBlock Text="{Binding LinkedLabel}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CountButton}" Margin="0,0,6,0" Command="{Binding SelectWithoutIdCommand}">
                                <StackPanel>
                                    <TextBlock Text="{Binding WithoutIdCount}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding WithoutIdColor}"/>
                                    <TextBlock Text="{Binding WithoutIdLabel}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CountButton}" Command="{Binding SelectNotInProjectCommand}">
                                <StackPanel>
                                    <TextBlock Text="{Binding NotInProjectCount}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding NotInProjectColor}"/>
                                    <TextBlock Text="{Binding NotInProjectLabel}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Not reachable, the project gone, or the check's own fault -->
                <Border Margin="14,12,14,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#F3C7C1" Background="#FCEBE9"
                        Visibility="{Binding ShowBanner, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 L2,20 H22 Z M12,10 V14 M12,17.5 V17.51" Stroke="#C03A2B" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel>
                            <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" Foreground="#8A281C" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BannerText}" FontSize="12" Foreground="#8A281C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource RedButton}" Content="Try again" Command="{Binding CheckNowCommand}"
                                        Visibility="{Binding BannerCanRetry, Converter={StaticResource Visible}}"/>
                                <Button Style="{StaticResource RedButton}" Content="Change project…" Command="{Binding LinkCommand}"
                                        Visibility="{Binding BannerOffersLink, Converter={StaticResource Visible}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- What the last Apply did -->
                <Border Margin="14,12,14,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{Binding AppliedLine}"
                        Background="{Binding AppliedBack}" Visibility="{Binding ShowApplied, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M8.5,12.5 L11,15 L16,10" Stroke="#1F8A4C" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding AppliedSomething, Converter={StaticResource Visible}}"/>
                                <Path Data="M12,3 L2,20 H22 Z M12,10 V14 M12,17.5 V17.51" Stroke="#B7791F" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding AppliedNothing, Converter={StaticResource Visible}}"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel>
                            <TextBlock Text="{Binding AppliedTitle}" FontWeight="SemiBold" Foreground="{Binding AppliedText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding AppliedDetail}" FontSize="12" Foreground="{Binding AppliedText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource MutedText}" Margin="14,12,14,0" Text="Comparing the model with the database…"
                           Visibility="{Binding ShowComparing, Converter={StaticResource Visible}}"/>

                <!-- Up to date -->
                <Border Margin="14,12,14,0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}"
                        Visibility="{Binding ShowUpToDate, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="#E7F5EC"
                                VerticalAlignment="Top" Margin="0,0,10,0">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20,6 L9,17 L4,12" Stroke="#1F8A4C" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding UpToDateTitle}" FontWeight="SemiBold" Foreground="{StaticResource Strong}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="{Binding UpToDateText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- The changes -->
                <StackPanel Margin="14,12,14,0" Visibility="{Binding ShowChanges, Converter={StaticResource Visible}}">
                    <DockPanel Margin="0,0,0,10" MinHeight="30">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Apply all" Margin="8,0,0,0"
                                VerticalAlignment="Center" Command="{Binding ApplyAllCommand}"
                                Visibility="{Binding CanApply, Converter={StaticResource Visible}}"
                                ToolTip="Writes all of them into the model, in one undo step"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ChangesTitle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ApplyWaitsText}" Margin="0,0,0,10"
                               Visibility="{Binding ShowApplyWaits, Converter={StaticResource Visible}}"/>
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource ChangeGroupTemplate}" Focusable="False"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding MoreText}"
                               Visibility="{Binding ShowMore, Converter={StaticResource Visible}}"/>
                </StackPanel>

                <!-- What Apply leaves out, and why -->
                <Border Margin="0,12,0,0" Padding="14,8,14,6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Visibility="{Binding ShowNotApplied, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <Button Style="{StaticResource PlainButton}" HorizontalAlignment="Stretch" Padding="0,4"
                                Command="{Binding ToggleNotAppliedCommand}" ToolTip="Shows or hides what Apply leaves out">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                        <DockPanel>
                                            <Viewbox DockPanel.Dock="Right" Width="14" Height="14">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M6,9 L12,15 L18,9" Stroke="{StaticResource Muted}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="{Binding NotAppliedTurn}" CenterX="12" CenterY="12"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding NotAppliedTitle}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#1F6FEB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <ItemsControl ItemsSource="{Binding NotAppliedItems}" Focusable="False" Margin="0,6,0,0"
                                      Visibility="{Binding NotAppliedOpen, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{Binding Icon}" Stroke="{Binding IconColor}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Strong}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}" Margin="0,2,0,0"/>
                                            <Button Style="{StaticResource LinkButton}" Margin="-6,2,0,0" Content="Check parameters…"
                                                    Command="{Binding CheckParametersCommand}"
                                                    Visibility="{Binding OffersCheckParameters, Converter={StaticResource Visible}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <StackPanel Margin="14,10,14,14">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastPullText}" Margin="0,0,0,8"
                               Visibility="{Binding ShowLastPull, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- How often to look -->
        <Border Grid.Row="2" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="14,10,14,12" Visibility="{Binding ShowFooter, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock Text="Look for changes" FontSize="12" FontWeight="SemiBold" Foreground="#3F4855"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                          DisplayMemberPath="Label" Height="30" FontSize="12.5" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Look for changes"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
