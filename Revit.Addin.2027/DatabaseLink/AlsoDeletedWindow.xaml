<Window x:Class="Revit.Addin._2027.DatabaseLink.AlsoDeletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace parameters"
        Width="760" Height="540" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF" Foreground="#2A3447" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <!-- The elements Revit deletes with the parameters Replace would delete, listed before anything goes.
         The look follows the Check parameters dialog, with the Other GUID red. -->
    <Window.Resources>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Show in a new view: greyed out when none of the elements is one a view can show. -->
        <Style x:Key="ShowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#8C95A5"/>
                    <Setter Property="BorderBrush" Value="#DDE1E7"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Deleting is what this button does, so it's the filled red one; Enter never presses it. -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#C03A2B"/>
            <Setter Property="BorderBrush" Value="#C03A2B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A33022"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ElementRowTemplate">
            <Border Padding="12,7" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#0F1B2D" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" FontSize="11.5" Foreground="#5B6578"
                                   TextWrapping="Wrap" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="0,0,12,0" Text="{Binding Kind}" FontSize="12" Foreground="#3F4855"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Kind}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Margin="0,0,12,0" Text="{Binding Id}" FontFamily="{StaticResource CodeFont}"
                               FontSize="11.5" Foreground="#2A3447" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Parameter}" FontSize="12" Foreground="#3F4855"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Parameter}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- What goes, and why -->
        <DockPanel Grid.Row="0" Margin="24,20,24,14">
            <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" CornerRadius="8"
                    Background="#FCEBE9" VerticalAlignment="Top">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,3 L2,20 L22,20 Z M12,10 V14 M12,17.5 V17.51" Stroke="#C03A2B" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="#0F1B2D" TextWrapping="Wrap"/>
                <TextBlock x:Name="IntroText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5B6578"/>
            </StackPanel>
        </DockPanel>

        <!-- Show them in a view of their own; or why a view can't -->
        <DockPanel Grid.Row="1" Margin="24,0,24,10">
            <Button x:Name="ShowButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource ShowButton}"
                    Click="OnShow" ToolTipService.ShowOnDisabled="True"/>
            <TextBlock x:Name="ShowNoteText" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- The elements -->
        <Border Grid.Row="2" Margin="24,0" CornerRadius="8" BorderThickness="1" BorderBrush="#E4E7EC" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,8" Background="#F7F8FA" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid x:Name="HeaderColumns">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#5B6578"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Grid.Column="0" Text="ELEMENT"/>
                        <TextBlock Grid.Column="1" Text="KIND"/>
                        <TextBlock Grid.Column="2" Text="ID"/>
                        <TextBlock Grid.Column="3" Text="GOES WITH"/>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="RowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnRowsScrollChanged">
                    <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource ElementRowTemplate}"
                                  AutomationProperties.Name="Elements Revit deletes"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock x:Name="MoreText" Grid.Row="3" Margin="24,8,24,0" FontSize="12" Foreground="#5B6578" Visibility="Collapsed"/>

        <!-- Buttons: Cancel is the safe way out, and Esc presses it -->
        <Border Grid.Row="4" Margin="0,16,0,0" Padding="24,14" Background="#F7F8FA" BorderBrush="#E4E7EC"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource DeleteButton}"
                        Click="OnDelete"/>
                <Button x:Name="OthersButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}"
                        Click="OnOthers"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" IsCancel="True" Content="Cancel"/>
                <TextBlock Text="Nothing is deleted until you click the red button." FontSize="12" Foreground="#5B6578"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
