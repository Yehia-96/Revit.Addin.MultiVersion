<Window x:Class="Revit.Addin._2027.DatabaseLink.CheckParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check parameters"
        Width="840" Height="660" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF" Foreground="#2A3447" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <!-- The look follows the mockup (claude.ai/artifact/TVSdpLgGotaWpp4PNro3Ed, "Parameters in this model"). -->
    <Window.Resources>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A5FCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#5B6578"/>
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="BorderBrush" Value="#C9CFD8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Replace deletes the model's parameters, so its button wears the Other GUID red. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#A33022"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2A59D"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- The segmented tabs: All · Missing · Other GUID · Ready -->
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#0F1B2D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ParameterRowTemplate">
            <Border Padding="12,8" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#0F1B2D" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" FontSize="11.5" Foreground="#5B6578"
                                   TextWrapping="Wrap" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="0,0,12,0" Text="{Binding Key}" FontFamily="{StaticResource CodeFont}"
                               FontSize="11.5" Foreground="#2A3447" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Key}"/>
                    <TextBlock Grid.Column="2" Margin="0,0,12,0" Text="{Binding Category}" FontSize="12" Foreground="#3F4855"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,1" CornerRadius="10"
                            Background="{Binding PillBackground}">
                        <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PillForeground}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, and where the parameters come from -->
        <DockPanel Grid.Row="0" Margin="24,20,24,12">
            <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" CornerRadius="8"
                    Background="#E8F0FE" VerticalAlignment="Top">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M11,6 H21 M11,12 H21 M11,18 H21 M3,6 L4.5,7.5 L7,5 M3,12 L4.5,13.5 L7,11 M3,18 L4.5,19.5 L7,17"
                              Stroke="#1F6FEB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel>
                <TextBlock Text="Parameters in this model" FontSize="18" FontWeight="SemiBold" Foreground="#0F1B2D"/>
                <TextBlock x:Name="Subtitle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5B6578"/>
            </StackPanel>
        </DockPanel>

        <!-- What's wrong with the master file or the database, or what Add did -->
        <Border x:Name="Banner" Grid.Row="1" Margin="24,0,24,12" Padding="12,10" CornerRadius="8" BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="12.5" Foreground="#1F2630"/>
        </Border>

        <!-- The tabs, and how many are ready -->
        <DockPanel Grid.Row="2" Margin="24,0,24,12">
            <TextBlock x:Name="Summary" DockPanel.Dock="Right" FontSize="12" Foreground="#5B6578" VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Left" Padding="2" CornerRadius="8" Background="#ECEEF2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllTab" Style="{StaticResource FilterTab}" GroupName="Filter" IsChecked="True" Checked="OnFilterChanged" Content="All"/>
                    <RadioButton x:Name="MissingTab" Style="{StaticResource FilterTab}" GroupName="Filter" Margin="2,0,0,0" Checked="OnFilterChanged" Content="Missing"/>
                    <RadioButton x:Name="OtherGuidTab" Style="{StaticResource FilterTab}" GroupName="Filter" Margin="2,0,0,0" Checked="OnFilterChanged" Content="Other GUID"/>
                    <RadioButton x:Name="ReadyTab" Style="{StaticResource FilterTab}" GroupName="Filter" Margin="2,0,0,0" Checked="OnFilterChanged" Content="Ready"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- The table -->
        <Border Grid.Row="3" Margin="24,0" CornerRadius="8" BorderThickness="1" BorderBrush="#E4E7EC" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,8" Background="#F7F8FA" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid x:Name="HeaderColumns">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#5B6578"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Grid.Column="0" Text="NAME IN REVIT"/>
                        <TextBlock Grid.Column="1" Text="IN THE DATABASE"/>
                        <TextBlock Grid.Column="2" Text="CATEGORY"/>
                        <TextBlock Grid.Column="3" Text="STATUS"/>
                    </Grid>
                </Border>
                <Grid>
                    <ScrollViewer x:Name="RowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnRowsScrollChanged">
                        <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource ParameterRowTemplate}"
                                      AutomationProperties.Name="Parameters"/>
                    </ScrollViewer>
                    <TextBlock x:Name="ListMessage" Margin="12,16" Foreground="#5B6578" TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- What Other GUID means, and Replace -->
        <Border x:Name="OtherGuidHint" Grid.Row="4" Margin="24,12,24,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="#F3C7C1" Background="#FCEBE9" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ReplaceButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource DangerButton}" Content="Replace…" Click="OnReplace"/>
                <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,3 L2,20 L22,20 Z M12,10 V14 M12,17.5 V17.51" Stroke="#C03A2B" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="OtherGuidHintText" TextWrapping="Wrap" FontSize="12.5" Foreground="#8A281C"/>
            </DockPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="5" Margin="0,16,0,0" Padding="24,14" Background="#F7F8FA" BorderBrush="#E4E7EC"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="AddButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Content="Nothing to add" Click="OnAdd"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" IsCancel="True" Content="Close"/>
                <TextBlock x:Name="FooterText" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
