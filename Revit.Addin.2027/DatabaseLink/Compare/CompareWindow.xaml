<Window x:Class="Revit.Addin._2027.DatabaseLink.Compare.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare with Excel"
        Width="860" Height="640" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF" Foreground="#2A3447" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <!-- Every difference between the Planungsdatenbank workbook and the same project in the MH database, in the
         look of the Check parameters dialog. Temporary (step 7). -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1F6FEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0" VerticalAlignment="Top"
                        Background="{Binding IconBack}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Icon}" Stroke="{Binding IconColor}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="SemiBold" Foreground="#0F1B2D" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Sources}" Margin="0,4,0,0" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Margin="0,2,0,0" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,4,20,12">
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,12,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="{Binding CountBack}" CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding CountColor}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F1B2D" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="#F7F8FA"
                                     Foreground="#2A3447" FontSize="12" Padding="10,8" Margin="0,6,0,0" TextWrapping="Wrap"
                                     AutomationProperties.Name="{Binding Title}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FooterButton}" Content="Copy the list" Click="OnCopy" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource FooterButton}" Content="Close" IsCancel="True"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap" Margin="0,0,16,0"
                           Text="Only read and compared. Nothing was changed, neither in the model nor in the database."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
