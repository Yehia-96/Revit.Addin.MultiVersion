<Window x:Class="Revit.Addin._2027.DatabaseLink.SignIn.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in"
        Width="560" Height="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFFFFF" Foreground="#2A3447" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" FocusManager.FocusedElement="{Binding ElementName=UserName}">

    <!-- The look follows the mockup (claude.ai/artifact/TVSdpLgGotaWpp4PNro3Ed, "Sign in to the MH database"). Its
         words come from SignInTexts. -->
    <Window.Resources>
        <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2630"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1F6FEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="BorderBrush" Value="#1F6FEB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A5FCC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#0F1B2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#5B6578"/>
                    <Setter Property="Background" Value="#ECEEF2"/>
                    <Setter Property="BorderBrush" Value="#C9CFD8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3F4855"/>
        </Style>

        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9CFD8"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#1F6FEB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,20,24,14">
            <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" CornerRadius="8" Background="#E8F0FE" VerticalAlignment="Top">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M16,8 A4,4 0 1 1 8,8 A4,4 0 1 1 16,8 Z M4,21 A8,8 0 0 1 20,21" Stroke="#1F6FEB" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="#0F1B2D" TextWrapping="Wrap"/>
                <TextBlock x:Name="Subtitle" Margin="0,4,0,0" Foreground="#5B6578" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,6,24,18">
                <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=UserName}" Content="_User name"/>
                <Border Style="{StaticResource Field}">
                    <TextBox x:Name="UserName" BorderThickness="0" Background="Transparent" Foreground="#0F1B2D" Padding="8,0"
                             VerticalContentAlignment="Center" MaxLength="256" TextChanged="OnUserNameChanged"
                             AutomationProperties.Name="User name"/>
                </Border>

                <Label Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Target="{Binding ElementName=Password}" Content="_Password"/>
                <Border x:Name="PasswordField" Style="{StaticResource Field}">
                    <PasswordBox x:Name="Password" BorderThickness="0" Background="Transparent" Foreground="#0F1B2D" Padding="8,0"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Password"/>
                </Border>

                <Border x:Name="Problem" Margin="0,14,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1" BorderBrush="#F3C7C1"
                        Background="#FCEBE9" Visibility="Collapsed">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M12,8 V13 M12,16.5 V16.51" Stroke="#C03A2B" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="ProblemText" FontSize="12.5" Foreground="#8A281C" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </DockPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1" BorderBrush="#E4E7EC" Background="#F7F8FA">
                    <StackPanel>
                        <TextBlock Text="Connection" FontSize="12" FontWeight="SemiBold" Foreground="#3F4855"/>
                        <TextBlock x:Name="Connection" Margin="0,6,0,0" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="#0F1B2D"
                                   TextWrapping="Wrap"/>
                        <DockPanel Margin="0,6,0,0">
                            <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M7,11 H17 A2,2 0 0 1 19,13 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V13 A2,2 0 0 1 7,11 Z M8,11 V8 A4,4 0 0 1 16,8 V11"
                                          Stroke="#5B6578" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="ConnectionNote" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                    <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" MinWidth="84" IsDefault="True" Click="OnSignIn"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12" Foreground="#5B6578" TextWrapping="Wrap" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
