    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <PackageReference Include="System.Memory.Data" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- WPF resources: embedded into the assembly for pack://application URIs.
       SDK-style projects don't auto-glob PNGs as <Resource>, so every icon must
       be declared explicitly (mirrors the old .NET Framework csproj). -->
  <ItemGroup>
    <Resource Include="Icons\AddMaterialParametersRE.png" />
    <Resource Include="Icons\FamilyFileUpdate.png" />
    <Resource Include="Icons\HideElementsIcon.png" />
    <Resource Include="Icons\ModernIcons\32\AddMaterialParametersRE.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ModernIcons\32\FamilyFileUpdate.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ModernIcons\32\HideElementsIcon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ModernIcons\32\ParameterAutomationIcon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ModernIcons\32\PopulateDbIcon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ModernIcons\32\Tables_Icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ModernIcons\32\Update_plugin.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icons\ParameterAutomationIcon.png" />
    <Resource Include="Icons\Tables_Icon.png" />
    <Resource Include="Icons\Update_plugin.png" />
  </ItemGroup>

  <!-- Addin manifest must be present in project dir so post-build can find it -->
  <ItemGroup>
    <None Include="Revit.Addin.2027.addin" />
    <None Include="Scripts\_Common.ps1" />
    <None Include="Scripts\Deploy-Local.ps1" />
    <None Include="Scripts\Publish-ToShare.ps1" />
    <None Include="Scripts\Update-FromShare.ps1" />
    <None Include="Scripts\Install.ps1" />
    <None Include="Scripts\Bump-Version.ps1" />
    <None Include="Scripts\Release-Wizard.ps1" />
    <None Include="Scripts\README.md" />
    <None Include="Scripts\New-Package.ps1" />
    <None Include="version.txt" />
    <None Include="version-docs.xlsx" />
  </ItemGroup>


  <!-- Post-build: copy DLLs and .addin file, behaviour depends on configuration -->
  <Target Name="CustomPostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Scripts\Deploy-Local.ps1&quot; -SourceDir &quot;$(TargetDir)&quot;" />
  </Target>

</Project>
