<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MH.RevitTools.Database\MH.RevitTools.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The connection file that ships inside the add-in, built in as there, so the tests can see that it can be read, what it
       says and that it holds no password; and the add-in's project, to see that it's built in there. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Revit.Addin.2027\database.json" LogicalName="database.json" />
    <None Include="..\Revit.Addin.2027\Revit.Addin.2027.csproj" Link="Connection\Revit.Addin.2027.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Check for Updates: the Revit-free part, compiled into the tests, and every year's files, to see that they're the same -->
  <ItemGroup>
    <Compile Include="..\Revit.Addin.2027\Services\PluginUpdate.cs" Link="AddinUpdate\PluginUpdate.cs" />
    <None Include="..\Revit.Addin.2024\Services\PluginUpdate.cs" Link="AddinUpdate\2024\PluginUpdate.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Services\PluginUpdate.cs" Link="AddinUpdate\2026\PluginUpdate.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Services\PluginUpdate.cs" Link="AddinUpdate\2027\PluginUpdate.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Commands\CheckPluginUpdate.cs" Link="AddinUpdate\2024\CheckPluginUpdate.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Commands\CheckPluginUpdate.cs" Link="AddinUpdate\2026\CheckPluginUpdate.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Commands\CheckPluginUpdate.cs" Link="AddinUpdate\2027\CheckPluginUpdate.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\App.cs" Link="AddinUpdate\2024\App.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\App.cs" Link="AddinUpdate\2026\App.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\App.cs" Link="AddinUpdate\2027\App.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Revit.Addin.2024.csproj" Link="AddinUpdate\2024\Revit.Addin.2024.csproj.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Excel import: the Revit-free parts, compiled into the tests, and every year's shared files, to see that they're the same.
       Those in Own differ between the years, as 2027 shares Add Parameters' loop with the database link. -->
  <ItemGroup>
    <Compile Include="..\Revit.Addin.2027\Services\ParameterRun.cs" Link="ExcelImport\ParameterRun.cs" />
    <Compile Include="..\Revit.Addin.2027\Services\SharedParameterNames.cs" Link="ExcelImport\SharedParameterNames.cs" />
    <Compile Include="..\Revit.Addin.2027\Services\Planungsdatenbank\WorkbookFile.cs" Link="ExcelImport\WorkbookFile.cs" />
    <None Include="..\Revit.Addin.2024\Services\Planungsdatenbank\*.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Services\ParameterRun.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Services\SharedParameterNames.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Helpers\ProjectParameterBinder.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Helpers\SharedParameterSeeder.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Helpers\SeedMaterialParameters.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Commands\MaterialAutomationCommand.cs" Link="ExcelImport\2024\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Helpers\SeedProjectElementsParameters.cs" Link="ExcelImport\2024\Own\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2024\Services\ParamMetaData.cs" Link="ExcelImport\2024\Own\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Services\Planungsdatenbank\*.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Services\ParameterRun.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Services\SharedParameterNames.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Helpers\ProjectParameterBinder.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Helpers\SharedParameterSeeder.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Helpers\SeedMaterialParameters.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Commands\MaterialAutomationCommand.cs" Link="ExcelImport\2026\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Helpers\SeedProjectElementsParameters.cs" Link="ExcelImport\2026\Own\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2026\Services\ParamMetaData.cs" Link="ExcelImport\2026\Own\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Services\Planungsdatenbank\*.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Services\ParameterRun.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Services\SharedParameterNames.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Helpers\ProjectParameterBinder.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Helpers\SharedParameterSeeder.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Helpers\SeedMaterialParameters.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Commands\MaterialAutomationCommand.cs" Link="ExcelImport\2027\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Helpers\SeedProjectElementsParameters.cs" Link="ExcelImport\2027\Own\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Revit.Addin.2027\Services\ParamMetaData.cs" Link="ExcelImport\2027\Own\%(Filename)%(Extension).txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SQL scripts the LocalDB tests run in their throwaway databases -->
  <ItemGroup>
    <None Update="Link\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
